diff --git a/env/seed_manager/seed_manager.py b/env/seed_manager/seed_manager.py
index 3c8c74f..3ab0e51 100644
--- a/env/seed_manager/seed_manager.py
+++ b/env/seed_manager/seed_manager.py
@@ -43,6 +43,22 @@ class SeedManager:
             self.seed_info[idx] = {"scene_layout": file_path}
 
         all_layout_ids = list(range(len(matching_files)))
+        # Restrict the queue itself so failed/unstable episodes cannot be
+        # replaced by an unrequested layout. EVAL_NUM only caps scored results.
+        layout_ids_env = os.environ.get("EVAL_LAYOUT_IDS")
+        if layout_ids_env is not None:
+            fields = [value.strip() for value in layout_ids_env.split(",")]
+            if not fields or any(re.fullmatch(r"[0-9]+", value) is None for value in fields):
+                raise ValueError("EVAL_LAYOUT_IDS must be a non-empty comma-separated list of nonnegative integers")
+            requested = [int(value) for value in fields]
+            requested_set = set(requested)
+            if len(requested_set) != len(requested):
+                raise ValueError("EVAL_LAYOUT_IDS must not contain duplicate layout IDs")
+            missing = sorted(requested_set - set(all_layout_ids))
+            if missing:
+                raise ValueError(f"EVAL_LAYOUT_IDS contains unavailable layout IDs for {self.task_name}: {missing}")
+            all_layout_ids = [layout_id for layout_id in all_layout_ids if layout_id in requested_set]
+            print(f"[SeedManager] EVAL_LAYOUT_IDS restricts the queue to {all_layout_ids}")
         excluded = set(int(s) for s in (completed_layout_ids or [])) | set(int(s) for s in (abandoned_layout_ids or []))
         if excluded:
             self.seed_list: List[int] = [s for s in all_layout_ids if s not in excluded]
